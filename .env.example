# ------------------------------------------------------------------
# Altis Weather-Aware Cashflow — environment configuration
# Copy to `.env.local` (Next.js) and `.env` (pipeline). NEVER commit real values.
# ------------------------------------------------------------------

# --- Data backend ---------------------------------------------------
# 'supabase' (cloud + auth) or 'sqlite' (local, no auth). If unset, the app
# uses Supabase when the keys below are present, otherwise SQLite.
DATA_BACKEND=sqlite
# Path to the generated SQLite database (used in sqlite mode).
ALTIS_DB_PATH=./data/altis.db

# --- Supabase (cloud backend + Auth + iOS) --------------------------
# Fill these to enable the Supabase backend, login/RBAC, and the iOS app.
# NEVER commit real values — .env.local is gitignored. Rotate the access
# token after the hackathon (see DATA_HANDLING.md).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...     # public (client); RLS-protected
# SUPABASE_SERVICE_ROLE_KEY=...         # server only, NEVER expose to client
# SUPABASE_PROJECT_REF=your-project-ref # used by push/purge scripts + admin purge
# SUPABASE_ACCESS_TOKEN=sbp_...         # Supabase Management API (schema/purge)

# --- Weather service (Open-Meteo) ----------------------------------
# Open-Meteo's forecast + ERA5 archive APIs are free and need NO API key.
# These are the default endpoints; override only if you proxy/cache them.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# Days of live forecast to request (Open-Meteo max is 16).
WEATHER_FORECAST_DAYS=16

# --- Supplemental weather detail (RapidAPI Weather API 167) ---------
# Used by the dashboard for current conditions, hourly probability,
# daily condition labels, and air quality. Server-side only.
# WEATHER_API167_RAPIDAPI_KEY=...
# WEATHER_API167_RAPIDAPI_HOST=weather-api167.p.rapidapi.com
# Set to false if you do not want local demo fallback via https://weather-api.site.
WEATHER_API167_USE_DIRECT_FALLBACK=true

# --- Pipeline -------------------------------------------------------
# Where the raw Excel exports are staged for ingestion (gitignored).
ALTIS_RAW_DIR=./data/raw
